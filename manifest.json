{
  "manifest_version": 3,
  "name": "Anki New Tab",
  "version": "0.2.0",
  "description": "Shows a random due Anki card on every new tab, via the AnkiConnect add-on, with a Pomodoro timer.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["http://127.0.0.1:8765/*"]
}
